//sd card
IO_LOC  "sd_sclk" 83;
IO_PORT "sd_sclk" IO_TYPE=LVCMOS33;
IO_LOC  "sd_cmd" 82;
IO_PORT "sd_cmd" IO_TYPE=LVCMOS33;
IO_LOC  "sd_dat0" 84;
IO_PORT "sd_dat0" IO_TYPE=LVCMOS33;
IO_LOC  "sd_dat1" 85;
IO_PORT "sd_dat1" IO_TYPE=LVCMOS33;
IO_LOC  "sd_dat2" 80;
IO_PORT "sd_dat2" IO_TYPE=LVCMOS33;
IO_LOC  "sd_dat3" 81;
IO_PORT "sd_dat3" IO_TYPE=LVCMOS33;

// ESP-01S UART removed: pins 27/28 are DB9 lines on this shield (Fire1 / Down).
// WiFi would need the companion route instead -- see the plan.


// DB9 joystick on the MiSTeryShield20k RPi Pico USB shield.
// These are MiSTeryNano's / NanoMig's "DB9 port 1" pins (js0[] in
// NanoMig's nanomig.cst), confirmed against this shield's PCB netlist: the
// joystick nets land on J4 pads 8-13, and pad 14 carries P31, which anchors
// that run of the header to FPGA pins 25-31.
// Active low: switch to ground, so internal pull-ups are enabled.
IO_LOC  "db9[0]" 27;
IO_PORT "db9[0]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "db9[1]" 28;
IO_PORT "db9[1]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "db9[2]" 25;
IO_PORT "db9[2]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "db9[3]" 26;
IO_PORT "db9[3]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "db9[4]" 29;
IO_PORT "db9[4]" PULL_MODE=UP IO_TYPE=LVCMOS33;
IO_LOC  "db9[5]" 30;
IO_PORT "db9[5]" PULL_MODE=UP IO_TYPE=LVCMOS33;
