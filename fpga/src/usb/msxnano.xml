<?xml version="1.0" encoding="utf-8"?>
<!--
  MSXHero - FPGA-Companion OSD menu definition.

  This is the overlay FPGA-Companion renders when F12 is pressed. It is served
  from the core over SPI: sysctrl CMD 8 streams the gzipped form of this file
  from msxnano_xml.hex, so no copy is needed on the SD card and no fork of the
  companion firmware is needed either - its menu is entirely described here.

  Regenerate msxnano_xml.hex with make_menu_rom.sh after editing this. Never
  edit the .hex by hand.

  The name is "MSXHero" without a board suffix on purpose. The same menu is
  meant to serve the ECP5 build as well as this Tang Nano one, and the config
  name is what the companion shows as the OSD title and what names the settings
  file. Board-specific naming lives in the boot menu instead, which titles
  itself "MSXHero TN 1.0".

  Deliberately NOT included: file selectors. The core has its own SD browser
  with mapper auto-detection, which the companion's selector cannot match.
  Loading stays in the core; this menu is for settings and reset.
-->
<config name="MSXHero" version="0">

  <actions>
    <!-- run as soon as this file is parsed; keep the machine in reset -->
    <action name="init">
      <load file="msxhero.ini"/>
      <set id="R" value="1"/>
    </action>

    <!-- run once initialisation is complete; release reset -->
    <action name="ready">
      <set id="R" value="0"/>
    </action>

    <action name="save">
      <save file="msxhero.ini"/>
    </action>

    <action name="reset">
      <set id="R" value="1"/>
      <delay ms="10"/>
      <set id="R" value="0"/>
    </action>

    <action name="reset_hide">
      <link action="reset"/>
      <hide/>
    </action>

    <!-- cold reset: needed for Boot Turbo, which is only applied on a cold start -->
    <action name="cold_reset">
      <set id="R" value="3"/>
      <delay ms="10"/>
      <set id="R" value="0"/>
    </action>

    <action name="cold_reset_hide">
      <link action="cold_reset"/>
      <hide/>
    </action>
  </actions>

  <menu label="MSXHero">

    <menu label="System">
      <!-- Applied by resetting into the new speed: switching CPU cadence while
           running hangs the machine, since clk_54m is the domain the cadence mux
           lives in and it has little timing margin. -->
      <list label="Turbo:" id="T" default="0" action="reset">
        <listentry label="3.58 MHz" value="0"/>
        <listentry label="5.37 MHz" value="1"/>
      </list>
      <!-- persisted; only takes effect on the next cold boot -->
      <toggle label="Boot in turbo:" id="B" default="0"/>
      <!-- 50Hz for European software, 60Hz for Japanese/US -->
      <list label="Video std:" id="P" default="0">
        <listentry label="60Hz NTSC" value="0"/>
        <listentry label="50Hz PAL" value="1"/>
      </list>
      <list label="Keyboard:" id="K" default="0">
        <listentry label="International" value="0"/>
        <listentry label="Japanese" value="1"/>
        <listentry label="Spanish" value="2"/>
      </list>
    </menu>

    <menu label="Input">
      <!-- which MSX joystick port the shield's DB9 answers on -->
      <list label="DB9 port:" id="J" default="0">
        <listentry label="Port 1" value="0"/>
        <listentry label="Port 2" value="1"/>
      </list>
      <!-- autofire on pad buttons 3 and 4 -->
      <list label="Autofire:" id="F" default="1">
        <listentry label="Off" value="0"/>
        <listentry label="5 Hz" value="1"/>
        <listentry label="10 Hz" value="2"/>
        <listentry label="20 Hz" value="3"/>
      </list>
    </menu>

    <menu label="Video">
      <toggle label="Scanlines:" id="S" default="0"/>
      <!-- HDMI AVI InfoFrame signalling; the display decides pillarbox vs stretch -->
      <list label="Aspect:" id="A" default="0">
        <listentry label="4:3" value="0"/>
        <listentry label="16:9" value="1"/>
      </list>
    </menu>

    <menu label="Audio">
      <!-- PSG1+SCC1+OPLL left / PSG2+SCC2+OPLL right; off = mono on both -->
      <toggle label="Stereo:" id="E" default="0"/>
      <!-- second SCC+ in the free primary slot, for dual-SCC trackers -->
      <toggle label="Second SCC+:" id="C" default="0"/>
      <!-- A drawn bar would need a new widget in FPGA-Companion's menu.c, so
           the bar is built out of ASCII in the labels instead. The OSD font is
           proportional over 128px, so bar plus percentage fits alongside the
           label with room to spare. Block glyphs are not in the font's range,
           hence # and - rather than the Unicode block elements. -->
      <list label="Volume:" id="V" default="4">
        <listentry label="[----] Mute" value="0"/>
        <listentry label="[#---] 25%" value="1"/>
        <listentry label="[##--] 50%" value="2"/>
        <listentry label="[###-] 75%" value="3"/>
        <listentry label="[####] 100%" value="4"/>
      </list>
    </menu>

    <button label="Save settings" action="save"/>
    <button label="Reset" action="reset_hide"/>
    <button label="Cold Boot" action="cold_reset_hide"/>
  </menu>

</config>
